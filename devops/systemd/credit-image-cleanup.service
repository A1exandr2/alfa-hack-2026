[Unit]
Description=Remove old Credit release images while keeping rollback versions
ConditionPathExists=/opt/credit/state/deployments.json
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n -E 0 /opt/credit/state/deploy.lock /usr/bin/python3 /opt/credit/current/devops/scripts/cleanup-images.py --apply
UMask=0077
