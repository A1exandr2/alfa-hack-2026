[Unit]
Description=Private bridge to Ollama running on the developer computer
Requires=docker.service credit.service
After=docker.service credit.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/credit-local-ai
Environment=GODEBUG=netdns=cgo
ExecStart=/usr/bin/docker compose -f /opt/credit-local-ai/compose.yml up -d --wait
ExecStop=/usr/bin/docker compose -f /opt/credit-local-ai/compose.yml stop
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
