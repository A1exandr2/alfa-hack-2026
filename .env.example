COMPOSE_PROJECT_NAME=credit
APP_BIND=127.0.0.1
APP_PORT=8080
POSTGRES_USER=credit
POSTGRES_PASSWORD=
POSTGRES_DB=credit
POSTGRES_PORT=55432
# Для backend вне Docker. Compose использует адрес postgres:5432.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Ollama model; make up downloads this model once into a persistent volume.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=120
