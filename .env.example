COMPOSE_PROJECT_NAME=
APP_BIND=
APP_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Для backend вне Docker. Compose использует адрес postgres:5432.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRATION_MINUTES=

# Ollama model; make up downloads this model once into a persistent volume.
OLLAMA_MODEL=
OLLAMA_TIMEOUT=

# Optional real company registry. Keep the key server-side. Empty = demo data.
DADATA_API_KEY=

# Real data by default. Synthetic financial/BKI fixtures only with DATA_MODE=demo.
DATA_MODE=
# Optional organization-owned BKI gateway implementing docs/financial-data.md.
CREDIT_HISTORY_API_URL=
CREDIT_HISTORY_API_TOKEN=

# Server-created administrator. ADMIN_LOGIN is an alias for ADMIN_EMAIL.
# ADMIN_PASSWORD is consumed only by the bootstrap command, never public registration.
ADMIN_LOGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
