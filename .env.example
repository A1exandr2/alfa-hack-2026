COMPOSE_PROJECT_NAME=credit
APP_BIND=127.0.0.1
APP_PORT=8080
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit
POSTGRES_PORT=55432
# Для backend вне Docker. Compose использует адрес postgres:5432.
DATABASE_URL=postgresql+asyncpg://credit:credit@localhost:55432/credit
# make init заменяет это значение случайным ключом.
JWT_SECRET=local-development-secret-change-me
JWT_EXPIRATION_MINUTES=60
